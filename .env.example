# Pluxee Mobile API Monitor Configuration
# Copy this file to .env and fill in your credentials

# Pluxee Mobile API credentials (intercepted from mobile app)
PLUXEE_API_CLAIM=your_api_claim_token_here
PLUXEE_CARD_ID=your_card_reference
PLUXEE_BENEFIT_ID=your_benefit_reference

# Telegram bot notifications & state persistence
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# How often to check for new transactions in seconds. Default: 60 (1 minute for real-time alerts)
POLL_INTERVAL_SECONDS=60

# Keepalive mode for Render free tier: 'smart' (active daytime, sleep night), 'off' (external cron), 'always'
KEEPALIVE_MODE=smart

# Web Push (PWA) Notifications (Optional — auto-generated in data/ if left empty)
# Run `python generate_vapid_keys.py` to generate a dedicated keypair for production/Render
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optional cloud persistence for the separate owner monitor only.
# Not needed for web login or the dashboard. Leave unset to use private local files.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# DASHBOARD_OWNER_ID=
# Exact production origin, for cross-site request protection.
APP_ORIGIN=
# Required for machine endpoints. Requests use Authorization: Bearer for cron,
# X-Telegram-Bot-Api-Secret-Token for Telegram. No URL query secrets.
CRON_SECRET=
TELEGRAM_WEBHOOK_SECRET=
